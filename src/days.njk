---
title: All Days of learning
layout: "base.njk"

---

<ul>
  {%- for day in collections.day | reverse -%}
    <li>
      <a href="{{ day.url | url}}">
        <article>
          <h2>{{ day.data.title }}</h2>
          <p class="date">{{ day.data.date | dayDate }}</p>
          <p>{{ day.data.summary }}</p>
        </article>
      </a>
    </li>
  {%- endfor -%}
</ul>
